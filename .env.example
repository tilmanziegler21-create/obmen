# Server-side Telegram bot token for exchange notifications
BOT_TOKEN=1234567890:your_bot_token

# Telegram group/user/channel ID where new requests will be sent
CHAT_ID=-1001234567890

# Public HTTPS URL of your Render service for Telegram webhook callbacks
PUBLIC_BASE_URL=https://your-render-domain.onrender.com

# Optional strict Telegram WebApp initData validation on backend
REQUIRE_TELEGRAM_INIT=false

# Telegram user IDs allowed on the backend for future admin validation
ADMIN_IDS=123456789,987654321

# Client-side hidden admin panel access
VITE_ADMIN_IDS=123456789,987654321

# Optional: Telegram file_id for /start welcome video (cached after first upload)
# START_VIDEO_FILE_ID=

# Optional: direct HTTPS URL for /start welcome video
# START_VIDEO_URL=

# Default local file used for /start video (commit as public/start.mp4):
# public/start.mp4
