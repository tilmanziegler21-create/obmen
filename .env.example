# Telegram bot token for exchange notifications
VITE_BOT_TOKEN=1234567890:your_bot_token

# Telegram user ID, group ID or channel ID where new requests will be sent
VITE_CHAT_ID=-1001234567890

# Telegram user IDs allowed to open the hidden admin panel
# Multiple IDs can be separated by commas
VITE_ADMIN_IDS=123456789,987654321
